<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Title>IR Portal Dashboard</Title>
  <Company>Mindful Health Solutions</Company>
 </DocumentProperties>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#1F2937"/>
  </Style>
  <Style ss:ID="title">
   <Font ss:FontName="Calibri" ss:Size="16" ss:Bold="1" ss:Color="#1F3A5F"/>
  </Style>
  <Style ss:ID="subtitle">
   <Font ss:FontName="Calibri" ss:Size="10" ss:Italic="1" ss:Color="#6B7280"/>
  </Style>
  <Style ss:ID="hdr">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#1F3A5F"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#1F3A5F" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="hdrSort">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#1F3A5F"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#2E5C8A" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="txt">
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
   </Borders>
   <NumberFormat ss:Format="@"/>
  </Style>
  <Style ss:ID="dt">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
   </Borders>
   <NumberFormat ss:Format="m/d/yyyy"/>
  </Style>
  <Style ss:ID="ctr">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E5E7EB"/>
   </Borders>
   <NumberFormat ss:Format="@"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="Dashboard">
  <Names>
   <NamedRange ss:Name="_FilterDatabase" ss:RefersTo="=Dashboard!R4C3:R1003C16" ss:Hidden="1"/>
  </Names>
  <Table ss:ExpandedColumnCount="16" x:FullColumns="1" x:FullRows="1" ss:DefaultRowHeight="18">
   <Column ss:Index="1" ss:Width="14"/>
   <Column ss:Width="14"/>
   <Column ss:Width="80"/>   <!-- C Incident ID -->
   <Column ss:Width="95"/>   <!-- D Last Name -->
   <Column ss:Width="85"/>   <!-- E First Name -->
   <Column ss:Width="55"/>   <!-- F Gender -->
   <Column ss:Width="72"/>   <!-- G DOB -->
   <Column ss:Width="190"/>  <!-- H Description -->
   <Column ss:Width="120"/>  <!-- I Prov Org -->
   <Column ss:Width="120"/>  <!-- J Facility -->
   <Column ss:Width="75"/>   <!-- K MRN -->
   <Column ss:Width="72"/>   <!-- L DOS -->
   <Column ss:Width="130"/>  <!-- M Provider -->
   <Column ss:Width="80"/>   <!-- N Last Activity -->
   <Column ss:Width="72"/>   <!-- O Due Date -->
   <Column ss:Width="72"/>   <!-- P Entry Date -->
   <Row ss:Height="26">
    <Cell ss:Index="3" ss:StyleID="title"><Data ss:Type="String">IR Portal Dashboard</Data></Cell>
   </Row>
   <Row>
    <Cell ss:Index="3" ss:StyleID="subtitle"><Data ss:Type="String">Sort order: Facility (Location) → Provider → MRN → Description. Paste portal rows starting in C5. Past-due Due Dates highlight red; due within 7 days highlight amber.</Data></Cell>
   </Row>
   <Row ss:Height="8"/>
   <Row ss:Height="32">
    <Cell ss:Index="3" ss:StyleID="hdr"><Data ss:Type="String">Incident ID</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">Last Name</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">First Name</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">Gender</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">DOB</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdrSort"><Data ss:Type="String">Description ④</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">Prov Org</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdrSort"><Data ss:Type="String">Facility ①</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdrSort"><Data ss:Type="String">MRN ③</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">DOS</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdrSort"><Data ss:Type="String">Provider ②</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">Last Activity</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">Due Date</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
    <Cell ss:StyleID="hdr"><Data ss:Type="String">Entry Date</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
   </Row>
   <Row>
    <Cell ss:Index="3" ss:StyleID="txt"/>
    <Cell ss:StyleID="txt"/>
    <Cell ss:StyleID="txt"/>
    <Cell ss:StyleID="ctr"/>
    <Cell ss:StyleID="dt"/>
    <Cell ss:StyleID="txt"/>
    <Cell ss:StyleID="txt"/>
    <Cell ss:StyleID="txt"/>
    <Cell ss:StyleID="ctr"/>
    <Cell ss:StyleID="dt"/>
    <Cell ss:StyleID="txt"/>
    <Cell ss:StyleID="dt"/>
    <Cell ss:StyleID="dt"/>
    <Cell ss:StyleID="dt"/>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <PageSetup>
    <Layout x:Orientation="Landscape"/>
    <PageMargins x:Left="0.3" x:Right="0.3" x:Top="0.5" x:Bottom="0.5"/>
   </PageSetup>
   <FitToPage/>
   <Print>
    <FitWidth>1</FitWidth>
    <FitHeight>0</FitHeight>
    <ValidPrinterInfo/>
   </Print>
   <Selected/>
   <DoNotDisplayGridlines/>
   <FreezePanes/>
   <FrozenNoSplit/>
   <SplitHorizontal>4</SplitHorizontal>
   <TopRowBottomPane>4</TopRowBottomPane>
   <ActivePane>2</ActivePane>
   <Panes>
    <Pane><Number>3</Number></Pane>
    <Pane><Number>2</Number><ActiveRow>4</ActiveRow><ActiveCol>2</ActiveCol></Pane>
   </Panes>
  </WorksheetOptions>
  <AutoFilter x:Range="R4C3:R1003C16" xmlns="urn:schemas-microsoft-com:office:excel"/>
  <ConditionalFormatting xmlns="urn:schemas-microsoft-com:office:excel">
   <Range>R5C15:R1003C15</Range>
   <Condition>
    <Value1>AND(RC&lt;&gt;&quot;&quot;,RC&lt;TODAY())</Value1>
    <Format Style='color:#9B1C1C;font-weight:700;background:#FDE2E2'/>
   </Condition>
   <Condition>
    <Value1>AND(RC&lt;&gt;&quot;&quot;,RC&lt;=TODAY()+7)</Value1>
    <Format Style='color:#92400E;background:#FEF3C7'/>
   </Condition>
  </ConditionalFormatting>
  <ConditionalFormatting xmlns="urn:schemas-microsoft-com:office:excel">
   <Range>R5C3:R1003C16</Range>
   <Condition>
    <Value1>AND(RC10&lt;&gt;&quot;&quot;,MOD(ROW(),2)=0)</Value1>
    <Format Style='background:#F3F6FA'/>
   </Condition>
  </ConditionalFormatting>
 </Worksheet>
</Workbook>
